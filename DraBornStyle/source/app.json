{
  "expo": {
    "name": "DraBornStyle",
    "slug": "drabornstyle",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "drabornstyle",
    "android": {
      "package": "com.draborneagle.style"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "DraBornStyle",
      "shortName": "DraBornStyle",
      "themeColor": "#080c14"
    },
    "experiments": {
      "baseUrl": "/DraBornStyle"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
