{
  "name": "drabornstyle",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "export:android": "expo export --platform android --output-dir dist-android",
    "test": "node --test tests/*.test.mjs",
    "build:web": "expo export --platform web && node scripts/export-site.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.98.0",
    "expo": "58.0.7",
    "expo-camera": "~58.0.9",
    "expo-crypto": "~58.0.6",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.8",
    "expo-haptics": "~58.0.5",
    "expo-linear-gradient": "~58.0.3",
    "expo-location": "~58.0.13",
    "expo-notifications": "~58.1.2",
    "expo-print": "~58.0.5",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.16",
    "fflate": "0.8.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.4",
    "react-native-maps": "1.29.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-svg": "15.15.5",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "supabase": "2.100.0",
    "typescript": "6.0.3"
  }
}
