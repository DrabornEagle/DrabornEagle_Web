{
  "rewrites": [
    {
      "source": "/DraBornPark/tag/:slug",
      "destination": "/DraBornPark/tag/index.html?token=:slug"
    },
    {
      "source": "/DraBornPark/t/:token",
      "destination": "/DraBornPark/t/index.html?token=:token"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {"key": "Content-Type", "value": "application/json; charset=utf-8"},
        {"key": "Cache-Control", "value": "public, max-age=300"}
      ]
    },
    {
      "source": "/DraBornPark",
      "headers": [
        {"key": "Cache-Control", "value": "private, no-store, no-cache, max-age=0, must-revalidate"},
        {"key": "CDN-Cache-Control", "value": "no-store"},
        {"key": "Vercel-CDN-Cache-Control", "value": "no-store"},
        {"key": "Surrogate-Control", "value": "no-store"},
        {"key": "Pragma", "value": "no-cache"},
        {"key": "Expires", "value": "0"}
      ]
    },
    {
      "source": "/DraBornPark/:path*",
      "headers": [
        {"key": "Cache-Control", "value": "private, no-store, no-cache, max-age=0, must-revalidate"},
        {"key": "CDN-Cache-Control", "value": "no-store"},
        {"key": "Vercel-CDN-Cache-Control", "value": "no-store"},
        {"key": "Surrogate-Control", "value": "no-store"},
        {"key": "Pragma", "value": "no-cache"},
        {"key": "Expires", "value": "0"}
      ]
    },
    {
      "source": "/api/drabornpark-contact",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0"},
        {"key": "CDN-Cache-Control", "value": "no-store"},
        {"key": "Vercel-CDN-Cache-Control", "value": "no-store"}
      ]
    }
  ]
}
